# ==================== remenberall 配置模板 ====================
# 复制为 .env 并填写真实值。.env 已加入 .gitignore，永不入库。
# 服务器上部署后请执行: chmod 600 .env

# ---------- DeepSeek（知识抽取） ----------
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 飞书自建应用（开放平台创建） ----------
# 申请权限: im:message / im:message:send_as_bot / docx:document
# 事件订阅使用「长连接」模式: im.message.receive_v1 / card.action.trigger
FEISHU_APP_ID=cli_your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# ---------- 提醒节奏 ----------
# 每天推送时段（24 小时制，逗号分隔）
PUSH_SLOTS=07:00,18:00
# 每时段推送上限（防堆积）
DAILY_CAP=15
# 时区
TIMEZONE=Asia/Shanghai

# ---------- 备份 ----------
# 每天备份到固定飞书在线文档的时段
BACKUP_TIME=03:10
# 备份文档 ID：首次运行自动创建并回填，通常无需填写
BACKUP_DOC_ID=

# ---------- 数据 ----------
# SQLite 数据目录
DATA_DIR=./data

# 你的飞书 open_id：不填则第一次给机器人发消息时自动记录
FEISHU_USER_OPEN_ID=
